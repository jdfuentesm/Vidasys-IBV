# ============================================
# VIDASYS-IBV — Plantilla de variables de entorno
# ============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo como ".env"
# 2. Rellena los valores con tus credenciales reales
# 3. El archivo .env NUNCA se sube a Git (está en .gitignore)
#
# Este archivo (.env.example) SÍ se sube a Git
# para que otros desarrolladores sepan qué variables necesitan.
# ============================================

# ---- Django ----
# Clave secreta de Django. Generar una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu_clave_secreta_aqui_cambiar_en_produccion

# Modo debug: True solo en desarrollo, False en producción
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Base de datos PostgreSQL ----
DB_NAME=gestion_ibv
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres_aqui
DB_HOST=127.0.0.1
DB_PORT=5432
