# Copiar a deploy/.env.demo (ignorado), completar valores seguros; nunca subirlo.
VIDASYS_DEMO=1
DJANGO_SETTINGS_MODULE=config.settings_demo_pg
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=demo.example.org
CSRF_TRUSTED_ORIGINS=https://demo.example.org
DB_NAME=vidasys_demo
DB_USER=vidasys_demo
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
FINANCIERO_CALENDARIO_BACKEND=postgresql
# El calendario vive en PostgreSQL, no requiere disco persistente web.
# Habilitar solo tras confirmar que el proxy sobrescribe X-Forwarded-Proto
# y el puerto de Gunicorn es privado.
TRUST_PROXY_HTTPS=False
PROXY_ALLOWED_IPS=127.0.0.1
WEB_CONCURRENCY=2
PORT=8000
